# ==============================================================================
# FinBERTx - Environment Variables Template (.env.example)
# نموذج متغيرات البيئة - انسخ هذا الملف إلى .env وضع بياناتك
# ==============================================================================

# 1. وسيط Capital.com (CFD Broker API)
CAPITAL_API_KEY=your_capital_api_key_here
CAPITAL_EMAIL=your_email@domain.com
CAPITAL_API_PASSWORD=your_password_here
TRADING_MODE=DEMO

# 2. تيلجرام (Telegram Bot & Channel)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
BACKTEST_INTERVAL_SEC=21600

# 3. مزودات البيانات والماكرو (FMP, FRED, Finnhub)
FMP_API_KEY=your_fmp_api_key_here
FRED_API_KEY=your_fred_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here

# 4. التداول التراكمي (Compounding Risk Percentage)
COMPOUNDING_RISK_PERCENT=3.0

# 5. الخادم ولوحة التحكم
PORT=3000
HOST=0.0.0.0
